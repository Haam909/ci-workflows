#!/usr/bin/env bash
# tests/onboard/run — onboard real repos in every configuration and check the
# whole path: onboard init/apply/check, a feature PR through the gate, and a
# release whose draft assets are verified.
#
#   tests/onboard/run L1 C4 ...     run these rows
#   tests/onboard/run --all         every row in rows.sh
#   tests/onboard/run --list        list the rows
#
# Options (environment):
#   CIW_UNDER_TEST   ci-workflows checkout whose local/bin/onboard and examples/
#                    are used (default: this checkout)
#   CIW_REF          ref the sandbox triggers call (default: v1)
#   OWNER            account that owns the sandboxes (default: the gh user)
#   KEEP_GOING=1     with several rows, don't stop at the first failure
#   POOL             number of public sandboxes (default: 10)
#   PRIVATE_POOL     number of private sandboxes, for private rows (default: 2)
#   WORK, RESULTS    where clones/logs and results/<row>.md go
#
# Rows run in a pool of sandbox repos, ${OWNER}/ciw-sbx-01..${POOL:-10}, and
# private rows in ${OWNER}/ciw-sbx-p01..${PRIVATE_POOL:-2}, each reset (not
# deleted) before a row uses it. Several runs can go at once; each
# row waits for a free sandbox. Results go to results/<row>.md.
#
# Needs: bash, git, gh (repo + workflow scopes), yq, jq, dotnet, node, python.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CIW_UNDER_TEST="${CIW_UNDER_TEST:-$(cd "${HERE}/../.." && pwd)}"
CIW_REF="${CIW_REF:-v1}"
OWNER="${OWNER:-$(gh api user --jq .login)}"
[[ -n "${OWNER}" ]] || { echo "can't read the gh user; set OWNER, or check gh auth status" >&2; exit 2; }
ONBOARD="${CIW_UNDER_TEST}/local/bin/onboard"
WORK="${WORK:-${TMPDIR:-${TEMP:-/tmp}}/ciw-onboard}"     # clones and logs, per row
RESULTS="${RESULTS:-${HERE}/results}"
LOCKS="${HOME}/.ciw-sandbox-locks"                       # shared by every run on this machine
mkdir -p "${LOCKS}"
mkdir -p "${WORK}" "${RESULTS}"

# shellcheck source=rows.sh
source "${HERE}/rows.sh"
# shellcheck source=lib.sh
source "${HERE}/lib.sh"

case "${1:-}" in
  ""|-h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list) declare -F | sed -n 's/^declare -f row_//p'; exit 0 ;;
  --all)  mapfile -t ROWS < <(declare -F | sed -n 's/^declare -f row_//p') ;;
  *)      ROWS=("$@") ;;
esac

for t in git gh yq jq dotnet node npm python; do command -v "$t" > /dev/null || { echo "$t is required" >&2; exit 2; }; done

FAILED_ROWS=(); INFRA_ROWS=()
for row in "${ROWS[@]}"; do
  declare -F "row_${row}" > /dev/null || { echo "no row ${row}" >&2; exit 2; }
  run_row "${row}"
  case $? in
    0) echo "PASS ${row}" ;;
    3) echo "INFRA ${row}"; INFRA_ROWS+=("${row}") ;;     # GitHub or the network; run it again
    *) echo "FAIL ${row}"; FAILED_ROWS+=("${row}"); [[ "${KEEP_GOING:-}" == 1 ]] || break ;;
  esac
done

[[ ${#INFRA_ROWS[@]} -eq 0 ]] || echo "infra (GitHub or the network, not the code; run again): ${INFRA_ROWS[*]}"
[[ ${#FAILED_ROWS[@]} -eq 0 ]] || { echo "failed: ${FAILED_ROWS[*]}"; exit 1; }
[[ ${#INFRA_ROWS[@]} -eq 0 ]] || exit 3
